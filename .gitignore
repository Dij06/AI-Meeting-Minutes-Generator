# Environment variables & API keys
.env
*.env
.env.local
.env.development
.env.production
!.env.example

# Local databases & instance folder
instance/
*.db
*.sqlite
*.sqlite3
*.pem
*.key

# Local notes & project context
PROJECT_CONTEXT.md
docs/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
